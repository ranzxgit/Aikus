{
  "expo": {
    "name": "Aikus",
    "slug": "aikus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mascot/app-icon.png",
    "scheme": "aikus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/mascot/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EE",
        "foregroundImage": "./assets/mascot/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F0",
          "image": "./logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFF8F0",
            "image": "./logo.png",
            "imageWidth": 200
          },
          "android": {
            "backgroundColor": "#FFF8F0",
            "image": "./logo.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#FFF8F0",
              "image": "./logo.png",
              "imageWidth": 200
            }
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Aikus to use your location to show nearby hospitals."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
